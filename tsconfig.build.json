{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "noEmit": false,
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": true
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "dist",
    "src/test.ts",
    "src/api",
    "src/**/__tests__",
    "src/**/__test__",
    "src/**/*.test.ts",
    "src/**/*.spec.ts"
  ]
}
